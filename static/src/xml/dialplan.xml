<?xml version="1.0" encoding="UTF-8"?>
<templates>

  <t t-name="freeswitch_cti.DialplanView" owl="1">
    <div class="o_dialplan_view">
      <div class="o_control_panel">
        <div class="o_cp_right">
          <button type="button" class="btn btn-primary" t-on-click="onSave">
            Save
          </button>
          <button type="button" class="btn btn-secondary" t-on-click="onCancel">
            Discard
          </button>
        </div>
      </div>
      <t t-component="props.Renderer" model="model" set-renderer="props.setRenderer"/>
    </div>
  </t>

  <t t-name="freeswitch_cti.DialplanRenderer">
    <div t-ref="root" class="o_dialplan_renderer"/>
  </t>

</templates>