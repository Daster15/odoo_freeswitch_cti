<templates xml:space="preserve">

  <t t-name="freeswitch_cti.DialplanView">
    <Layout display="props.display" className="'o_dialplan_layout h-100 overflow-auto'">
      <div class="o_control_panel">
        <div class="o_cp_right">
          <button type="button" class="btn btn-primary" t-on-click="onSave">Save</button>
          <button type="button" class="btn btn-secondary" t-on-click="onCancel">Discard</button>
        </div>
      </div>
      <!-- ✅ Owl 2 compliant: set-ref instead of t-ref -->
      <t t-component="props.Renderer" model="model" set-ref="props.setRenderer"/>
    </Layout>
  </t>

  <t t-name="freeswitch_cti.DialplanRendererRoot">
    <div class="o_dialplan_root"/>
  </t>

</templates>
